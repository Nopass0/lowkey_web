# ─── Local development defaults ─────────────────────────────────────────
# Copy this file to frontend/.env.local (which is gitignored) and adjust as needed.
# The dev scripts (./dev.sh, .\dev.ps1) start the backend on http://localhost:3001.

# Base URL the frontend calls for API requests. CORS is permissive in dev,
# so cross-origin (frontend:3000 → backend:3001) works out of the box.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG=false
